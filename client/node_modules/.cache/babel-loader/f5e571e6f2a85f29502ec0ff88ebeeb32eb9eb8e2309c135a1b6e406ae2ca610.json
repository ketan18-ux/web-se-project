{"ast":null,"code":"export function launchConfetti(){let canvas=document.getElementById('confetti-canvas');if(!canvas){canvas=document.createElement('canvas');canvas.id='confetti-canvas';canvas.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:99998;';document.body.appendChild(canvas);}canvas.width=window.innerWidth;canvas.height=window.innerHeight;const ctx=canvas.getContext('2d');const colors=['#FF9933','#138808','#ffffff','#FFB347','#10b981','#3b82f6','#fbbf24'];const pieces=Array.from({length:120},()=>({x:Math.random()*canvas.width,y:-10,r:Math.random()*6+3,color:colors[Math.floor(Math.random()*colors.length)],speed:Math.random()*3+1.5,drift:(Math.random()-0.5)*2,rotation:Math.random()*360,rSpeed:(Math.random()-0.5)*8,opacity:1,shape:Math.random()>0.5?'rect':'circle'}));let frame;function draw(){ctx.clearRect(0,0,canvas.width,canvas.height);pieces.forEach(p=>{ctx.save();ctx.globalAlpha=p.opacity;ctx.fillStyle=p.color;ctx.translate(p.x,p.y);ctx.rotate(p.rotation*Math.PI/180);if(p.shape==='rect')ctx.fillRect(-p.r,-p.r/2,p.r*2,p.r);else{ctx.beginPath();ctx.arc(0,0,p.r,0,Math.PI*2);ctx.fill();}ctx.restore();p.y+=p.speed;p.x+=p.drift;p.rotation+=p.rSpeed;if(p.y>canvas.height*0.7)p.opacity-=0.02;});if(pieces.some(p=>p.opacity>0))frame=requestAnimationFrame(draw);else{ctx.clearRect(0,0,canvas.width,canvas.height);canvas.remove();}}draw();setTimeout(()=>{cancelAnimationFrame(frame);canvas.remove();},5000);}","map":{"version":3,"names":["launchConfetti","canvas","document","getElementById","createElement","id","style","cssText","body","appendChild","width","window","innerWidth","height","innerHeight","ctx","getContext","colors","pieces","Array","from","length","x","Math","random","y","r","color","floor","speed","drift","rotation","rSpeed","opacity","shape","frame","draw","clearRect","forEach","p","save","globalAlpha","fillStyle","translate","rotate","PI","fillRect","beginPath","arc","fill","restore","some","requestAnimationFrame","remove","setTimeout","cancelAnimationFrame"],"sources":["E:/govportal-react/client/src/utils/confetti.js"],"sourcesContent":["export function launchConfetti() {\n  let canvas = document.getElementById('confetti-canvas');\n  if (!canvas) {\n    canvas = document.createElement('canvas');\n    canvas.id = 'confetti-canvas';\n    canvas.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:99998;';\n    document.body.appendChild(canvas);\n  }\n  canvas.width = window.innerWidth;\n  canvas.height = window.innerHeight;\n  const ctx = canvas.getContext('2d');\n  const colors = ['#FF9933','#138808','#ffffff','#FFB347','#10b981','#3b82f6','#fbbf24'];\n  const pieces = Array.from({ length: 120 }, () => ({\n    x: Math.random() * canvas.width, y: -10,\n    r: Math.random() * 6 + 3,\n    color: colors[Math.floor(Math.random() * colors.length)],\n    speed: Math.random() * 3 + 1.5,\n    drift: (Math.random() - 0.5) * 2,\n    rotation: Math.random() * 360,\n    rSpeed: (Math.random() - 0.5) * 8,\n    opacity: 1,\n    shape: Math.random() > 0.5 ? 'rect' : 'circle',\n  }));\n  let frame;\n  function draw() {\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    pieces.forEach(p => {\n      ctx.save();\n      ctx.globalAlpha = p.opacity;\n      ctx.fillStyle = p.color;\n      ctx.translate(p.x, p.y);\n      ctx.rotate(p.rotation * Math.PI / 180);\n      if (p.shape === 'rect') ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);\n      else { ctx.beginPath(); ctx.arc(0, 0, p.r, 0, Math.PI * 2); ctx.fill(); }\n      ctx.restore();\n      p.y += p.speed; p.x += p.drift; p.rotation += p.rSpeed;\n      if (p.y > canvas.height * 0.7) p.opacity -= 0.02;\n    });\n    if (pieces.some(p => p.opacity > 0)) frame = requestAnimationFrame(draw);\n    else { ctx.clearRect(0, 0, canvas.width, canvas.height); canvas.remove(); }\n  }\n  draw();\n  setTimeout(() => { cancelAnimationFrame(frame); canvas.remove(); }, 5000);\n}\n"],"mappings":"AAAA,MAAO,SAAS,CAAAA,cAAcA,CAAA,CAAG,CAC/B,GAAI,CAAAC,MAAM,CAAGC,QAAQ,CA